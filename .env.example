# Copy to .env (git-ignored) to change the Docker setup's defaults (see compose.yaml).

# Your time zone, so "today" in the plan is your today (default UTC).
TZ=America/New_York

# Port on this machine for the app (default 8000).
MARATHON_PORT=8000

# Who can reach it. 127.0.0.1 (the default): this machine only, or through the Caddy profile.
# To open it to your home network without Caddy (e.g. a home lab), use both of these instead:
#   MARATHON_BIND=0.0.0.0
#   FORWARDED_ALLOW_IPS=127.0.0.1   (nothing in front of the app, so don't trust forwarded headers)
MARATHON_BIND=127.0.0.1

# DEBUG, INFO, WARNING or ERROR.
MARATHON_LOG_LEVEL=INFO
