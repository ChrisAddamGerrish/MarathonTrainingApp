# Copy to deploy/caddy.env (which is git-ignored) and fill in, or let start.ps1 create it on its first run.
# See the Caddyfile for what each setting does.

# A domain pointing at your public IP gets automatic HTTPS; :8080 serves plain HTTP.
MARATHON_SITE=:8080

# public: Let's Encrypt certificate (real domain only). internal: Caddy's local CA, for
# home-network names like marathon.home.
MARATHON_TLS=public
